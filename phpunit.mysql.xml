<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="MySQLConcurrency">
            <file>tests/Feature/Company/CompanyOwnershipConcurrencyTest.php</file>
            <file>tests/Feature/Company/CompanyInvitationConcurrencyTest.php</file>
        </testsuite>
        <testsuite name="CustomerMySQL">
            <file>tests/Feature/Customer/CustomerGroupMembershipMigrationTest.php</file>
            <file>tests/Feature/Customer/CustomerAddressDefaultMigrationTest.php</file>
            <file>tests/Feature/Customer/CustomerPermissionMigrationTest.php</file>
            <file>tests/Feature/Customer/CustomerConcurrencyTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="goerion_phase2b1_concurrency_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
